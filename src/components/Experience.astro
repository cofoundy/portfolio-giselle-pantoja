---
import { siteConfig as defaultConfig } from "../config";
import BrandIcon from "./BrandIcon.astro";

interface Props {
  config?: typeof defaultConfig;
}

const { config = defaultConfig } = Astro.props;
const siteConfig = config;
const l = config.labels.experience;

const countryFlag: Record<string, string> = {
  "pe": "🇵🇪",
  "cl": "🇨🇱",
};
---

<section id="trayectoria" class="py-20 bg-white">
  <div class="max-w-4xl mx-auto px-6">
    <div class="reveal text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)] mb-2">
        {l.heading}
      </h2>
      <div class="w-16 h-1 bg-[var(--color-primary-light)] rounded-full mx-auto"></div>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-4 md:left-8 top-0 bottom-0 w-0.5 bg-[var(--color-primary-light)]/30"></div>

      <div class="space-y-8">
        {siteConfig.experience.map((exp, i) => (
          <div class={`reveal stagger-${Math.min(i + 1, 6)} relative pl-12 md:pl-20`}>
            <!-- Timeline dot -->
            <div class="absolute left-2.5 md:left-6.5 top-2 w-3 h-3 rounded-full bg-[var(--color-primary-light)] border-2 border-white shadow-md timeline-dot"></div>

            <!-- Card -->
            <div class="timeline-card bg-[var(--color-surface-light)] rounded-2xl p-6 border border-[var(--color-primary-light)]/10">
              <!-- Header -->
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
                <div class="flex items-start gap-3">
                  <BrandIcon name={exp.logo || exp.company} size={36} class="mt-1 flex-shrink-0" />
                  <div>
                    <h3 class="text-lg font-bold text-[var(--color-primary-dark)]">{exp.company}</h3>
                    <p class="text-sm font-semibold text-[var(--color-primary)]">{exp.title}</p>
                  </div>
                </div>
                <div class="flex items-center gap-2 text-sm text-gray-500">
                  <span>{countryFlag[exp.country]}</span>
                  <span class="whitespace-nowrap">{exp.period}</span>
                </div>
              </div>

              <!-- Bullets -->
              <ul class="space-y-1.5">
                {exp.bullets.map(bullet => (
                  <li class="text-sm text-gray-600 flex items-start gap-2">
                    <span class="w-1 h-1 rounded-full bg-[var(--color-primary-light)] mt-2 flex-shrink-0"></span>
                    {bullet}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}

      </div>
    </div>
  </div>
</section>
