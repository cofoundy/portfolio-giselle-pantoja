---
import { siteConfig } from "../config";
---

<section id="impacto" class="py-20 bg-[var(--color-surface-light)]">
  <div class="max-w-5xl mx-auto px-6">
    <div class="reveal text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)] mb-2">
        Impacto en Números
      </h2>
      <div class="w-16 h-1 bg-[var(--color-primary-light)] rounded-full mx-auto"></div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {siteConfig.impact.map((item, i) => (
        <div class={`reveal stagger-${i + 1} bg-white rounded-2xl p-8 border border-[var(--color-primary-light)]/10 shadow-sm text-center relative overflow-hidden`}>
          <!-- Decorative accent bar at top -->
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-primary-light)]"></div>

          <!-- Big number -->
          <div class="text-5xl md:text-6xl font-bold text-[var(--color-primary)] mb-2">
            {item.value}
          </div>

          <!-- Label -->
          <h3 class="text-lg font-semibold text-[var(--color-primary-dark)] mb-4">
            {item.label}
          </h3>

          <!-- Detail -->
          <p class="text-sm text-gray-500 leading-relaxed">
            {item.detail}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
