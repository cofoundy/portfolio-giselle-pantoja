---
interface Props {
  from?: string;
  to?: string;
  flip?: boolean;
}

const { from = "#0f2b4c", to = "#ffffff", flip = false } = Astro.props;
---

<div class="w-full overflow-hidden leading-[0]" style={`background: ${flip ? from : to};`}>
  <svg
    viewBox="0 0 1440 120"
    preserveAspectRatio="none"
    class={`w-full h-16 md:h-24 block ${flip ? 'rotate-180' : ''}`}
    style={`fill: ${flip ? to : from};`}
  >
    <path d="M0,0 C240,100 480,20 720,80 C960,140 1200,40 1440,90 L1440,0 L0,0 Z" />
  </svg>
</div>
