---
import { siteConfig } from "../config";
import BrandIcon from "./BrandIcon.astro";
---

<section id="certificaciones" class="py-20 bg-[var(--color-surface-light)]">
  <div class="max-w-5xl mx-auto px-6">
    <div class="reveal text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)] mb-2">
        Certificaciones & Educación
      </h2>
      <div class="w-16 h-1 bg-[var(--color-primary-light)] rounded-full mx-auto"></div>
    </div>

    <!-- Certifications -->
    <div class="max-w-3xl mx-auto mb-14">
      <div class="grid gap-3">
        {siteConfig.certifications.map((cert, i) => (
          <div class={`reveal stagger-${Math.min(i + 1, 6)} flex items-center gap-4 bg-white rounded-xl px-5 py-4 border border-gray-100 shadow-sm hover:shadow-md transition-shadow`}>
            <!-- Org logo or cert abbreviation -->
            <div class="w-10 h-10 flex-shrink-0 flex items-center justify-center">
              {cert.icon ? (
                <BrandIcon name={cert.icon} size={40} />
              ) : (
                <span class="text-sm font-bold text-[var(--color-primary)] tracking-tight">{cert.name}</span>
              )}
            </div>
            <!-- Cert info -->
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-[var(--color-primary-dark)]">{cert.fullName}</p>
              {cert.org && <p class="text-xs text-gray-500">{cert.org}</p>}
            </div>
            <!-- Badge pill -->
            <span class="hidden sm:inline text-[10px] font-bold tracking-wider text-[var(--color-primary-light)] uppercase flex-shrink-0">{cert.name}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Education -->
    <div class="reveal">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-[var(--color-primary)] mb-6 text-center">
        Formación Académica
      </h3>

      <div class="grid md:grid-cols-3 gap-4">
        {siteConfig.education.map((edu, i) => (
          <div class={`reveal stagger-${i + 1} bg-white rounded-xl p-5 border border-gray-100 shadow-sm text-center hover:shadow-md transition-shadow`}>
            <h4 class="text-sm font-bold text-[var(--color-primary-dark)] mb-1 font-sans">{edu.degree}</h4>
            <p class="text-xs text-gray-500 font-sans">{edu.school}</p>
          </div>
        ))}
      </div>

      <!-- Diplomas -->
      <div class="mt-6 text-center">
        <p class="text-xs text-gray-400 uppercase tracking-wider mb-2">Diplomas</p>
        <div class="flex flex-wrap justify-center gap-2">
          {siteConfig.diplomas.map(d => (
            <span class="px-3 py-1 text-xs text-gray-600 bg-white rounded-full border border-gray-100">{d}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
