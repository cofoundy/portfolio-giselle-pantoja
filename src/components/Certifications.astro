---
import { siteConfig } from "../config";
import BrandIcon from "./BrandIcon.astro";

// Give each cert a distinct accent color for visual variety
const certColors: Record<string, { bg: string; text: string; border: string }> = {
  "PMP":     { bg: "bg-amber-500/15", text: "text-amber-400", border: "border-amber-500/30" },
  "SM":      { bg: "bg-emerald-500/15", text: "text-emerald-400", border: "border-emerald-500/30" },
  "PAL-EBM": { bg: "bg-sky-500/15", text: "text-sky-400", border: "border-sky-500/30" },
  "AC":      { bg: "bg-violet-500/15", text: "text-violet-400", border: "border-violet-500/30" },
  "BAF":     { bg: "bg-rose-500/15", text: "text-rose-400", border: "border-rose-500/30" },
  "ATF":     { bg: "bg-teal-500/15", text: "text-teal-400", border: "border-teal-500/30" },
};

const defaultColor = { bg: "bg-white/10", text: "text-[var(--color-primary-light)]", border: "border-white/20" };
---

<section id="certificaciones" class="py-20 bg-gradient-to-b from-[#0d2240] to-[#162d50] text-white">
  <div class="max-w-5xl mx-auto px-6">
    <div class="reveal text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-bold mb-2">
        Certificaciones & Educación
      </h2>
      <div class="w-16 h-1 bg-[var(--color-primary-light)] rounded-full mx-auto"></div>
    </div>

    <!-- Certification badges with color variety -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-14">
      {siteConfig.certifications.map((cert, i) => {
        const color = certColors[cert.name] || defaultColor;
        return (
          <div class={`reveal stagger-${Math.min(i + 1, 6)} cert-badge rounded-2xl p-5 border ${color.border} bg-white/[0.03] backdrop-blur-sm text-center`}>
            <!-- Badge: real logo if available, colored initials if not -->
            <div class={`w-16 h-16 mx-auto mb-3 rounded-full ${color.bg} flex items-center justify-center border ${color.border}`}>
              {cert.icon ? (
                <BrandIcon name={cert.icon} size={32} />
              ) : (
                <span class={`text-lg font-bold ${color.text}`}>{cert.name}</span>
              )}
            </div>
            <p class="text-sm font-medium text-white/90">{cert.fullName}</p>
            {cert.org && <p class="text-xs text-white/40 mt-1">{cert.org}</p>}
          </div>
        );
      })}
    </div>

    <!-- Education with more visual weight -->
    <div class="reveal">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-[var(--color-primary-light)] mb-6 text-center">
        Formación Académica
      </h3>

      <div class="grid md:grid-cols-3 gap-4">
        {siteConfig.education.map((edu, i) => (
          <div class={`reveal stagger-${i + 1} bg-white/[0.06] rounded-xl p-5 border border-white/10 text-center hover:bg-white/[0.1] transition-colors`}>
            <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-amber-500/15 flex items-center justify-center border border-amber-500/20">
              <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                {edu.icon === "graduation-cap" && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />}
                {edu.icon === "building" && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />}
                {edu.icon === "monitor" && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />}
              </svg>
            </div>
            <h4 class="text-sm font-bold text-white">{edu.degree}</h4>
            <p class="text-xs text-white/50 mt-1">{edu.school}</p>
          </div>
        ))}
      </div>

      <!-- Diplomas -->
      <div class="mt-6 text-center">
        <p class="text-xs text-white/40 uppercase tracking-wider mb-2">Diplomas</p>
        <div class="flex flex-wrap justify-center gap-2">
          {siteConfig.diplomas.map(d => (
            <span class="px-3 py-1 text-xs text-white/60 bg-white/5 rounded-full border border-white/10">{d}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
