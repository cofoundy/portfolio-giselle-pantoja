---
import { siteConfig } from "../config";
---

<section class="relative min-h-screen flex items-center bg-gradient-to-br from-[var(--color-primary-dark)] via-[#122d4f] to-[#0a1e36] overflow-hidden">
  <!-- Subtle grid pattern -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2240%22 height=%2240%22><rect width=%2240%22 height=%2240%22 fill=%22none%22 stroke=%22white%22 stroke-width=%220.5%22/></svg>');"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-6 py-20 md:py-0 w-full">
    <div class="flex flex-col md:flex-row items-center gap-10 md:gap-16">

      <!-- Photo -->
      <div class="hero-photo flex-shrink-0">
        <div class="relative">
          <div class="w-48 h-48 md:w-64 md:h-64 rounded-full overflow-hidden border-4 border-[var(--color-primary-light)]/30 shadow-2xl">
            <img
              src="/profile.jpg"
              alt={siteConfig.name}
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
          <!-- Glow ring -->
          <div class="absolute inset-0 rounded-full border-2 border-[var(--color-primary-light)]/20 scale-110"></div>
        </div>
      </div>

      <!-- Text content -->
      <div class="text-center md:text-left flex-1">
        <h1 class="hero-name text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight tracking-tight">
          Giselle<br />
          <span class="text-[var(--color-primary-light)]">Pantoja</span>
        </h1>

        <div class="hero-title mt-4 flex flex-wrap justify-center md:justify-start gap-2">
          {siteConfig.heroTags.map(tag => (
            <span class="px-3 py-1 text-xs font-semibold tracking-wider uppercase bg-white/10 text-white/80 rounded-full border border-white/10">
              {tag}
            </span>
          ))}
        </div>

        <p class="hero-tagline mt-5 text-lg md:text-xl text-white/70 font-light max-w-lg">
          {siteConfig.tagline}
        </p>

        <p class="hero-location mt-3 text-sm text-white/50 flex items-center justify-center md:justify-start gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          Santiago, Chile · Lima, Perú
        </p>

        <!-- Stats row -->
        <div class="hero-stats mt-8 grid grid-cols-3 gap-3">
          {siteConfig.stats.map(stat => (
            <div class="text-center md:text-left">
              <div class="text-2xl md:text-3xl font-bold text-white">{stat.value}</div>
              <div class="text-[10px] sm:text-xs text-white/50 mt-1 uppercase tracking-wider leading-tight">{stat.label}</div>
            </div>
          ))}
        </div>

        <!-- Social links -->
        <div class="hero-social mt-8 flex items-center justify-center md:justify-start gap-4">
          <a href={`mailto:${siteConfig.social.email}`} class="inline-flex items-center gap-2 bg-[var(--color-primary-light)] text-white px-5 py-2.5 rounded-full text-sm font-semibold hover:bg-[var(--color-primary-light)]/80 transition-colors" aria-label="Enviar email">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            Contacto
          </a>
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="w-10 h-10 flex items-center justify-center rounded-full bg-white/10 text-white/70 hover:bg-white/20 hover:text-white transition-all" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

</section>
