---
import { siteConfig } from "../config";
---

<section id="contacto" class="py-20 bg-gradient-to-br from-[var(--color-surface-light)] to-[var(--color-surface)]">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <div class="reveal">
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)] mb-4">
        ¿Trabajamos juntos?
      </h2>
      <p class="text-gray-600 mb-10 max-w-lg mx-auto">
        Estoy disponible para nuevos desafíos en gestión de proyectos, transformación digital y consultoría ágil.
      </p>
    </div>

    <div class="reveal stagger-1 grid sm:grid-cols-2 gap-4 max-w-md mx-auto mb-10">
      <!-- Email -->
      <a href={`mailto:${siteConfig.social.email}`} class="flex items-center gap-3 bg-white rounded-xl p-4 border border-[var(--color-primary-light)]/10 shadow-sm hover:shadow-md hover:border-[var(--color-primary-light)]/30 transition-all group">
        <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-[var(--color-primary)]/10 text-[var(--color-primary)] group-hover:bg-[var(--color-primary)] group-hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        </div>
        <div class="text-left">
          <p class="text-xs text-gray-500">Email</p>
          <p class="text-sm font-semibold text-[var(--color-primary-dark)]">Escríbeme</p>
        </div>
      </a>

      <!-- LinkedIn -->
      <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 bg-white rounded-xl p-4 border border-[var(--color-primary-light)]/10 shadow-sm hover:shadow-md hover:border-[var(--color-primary-light)]/30 transition-all group">
        <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-[var(--color-primary)]/10 text-[var(--color-primary)] group-hover:bg-[var(--color-primary)] group-hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </div>
        <div class="text-left">
          <p class="text-xs text-gray-500">LinkedIn</p>
          <p class="text-sm font-semibold text-[var(--color-primary-dark)]">Ver perfil</p>
        </div>
      </a>
    </div>

    <!-- Phone numbers -->
    <div class="reveal stagger-2 flex flex-col sm:flex-row items-center justify-center gap-4 text-sm text-gray-500">
      <div class="flex items-center gap-2">
        <span>🇨🇱</span>
        <span>{siteConfig.social.phoneCL}</span>
      </div>
      <span class="hidden sm:inline text-gray-300">·</span>
      <div class="flex items-center gap-2">
        <span>🇵🇪</span>
        <span>{siteConfig.social.phonePE}</span>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="py-6 bg-[var(--color-primary-dark)] text-center">
  <p class="text-xs text-white/30">
    &copy; {new Date().getFullYear()} {siteConfig.name}
  </p>
</footer>
