---
import { siteConfig } from "../config";

const iconMap: Record<string, string> = {
  "shield": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
  "credit-card": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />`,
  "shopping-bag": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />`,
  "road": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l5.447 2.724A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />`,
  "phone": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />`,
  "pickaxe": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />`,
  "megaphone": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />`,
};

const countryFlag: Record<string, string> = {
  "pe": "🇵🇪",
  "cl": "🇨🇱",
};
---

<section id="industrias" class="py-20 bg-[var(--color-primary-dark)] text-white">
  <div class="max-w-5xl mx-auto px-6">
    <div class="reveal text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-bold mb-2">
        Transformando Industrias
      </h2>
      <div class="w-16 h-1 bg-[var(--color-primary-light)] rounded-full mx-auto mb-4"></div>
      <p class="text-white/60 text-lg max-w-2xl mx-auto">
        Más de dos décadas llevando eficiencia, metodología ágil y transformación digital a sectores diversos
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {siteConfig.industries.map((ind, i) => (
        <div class={`reveal stagger-${Math.min(i + 1, 7)} industry-card group bg-white/5 backdrop-blur-sm rounded-2xl p-5 border border-white/10 cursor-default`}>
          <!-- Icon -->
          <div class="w-10 h-10 flex items-center justify-center rounded-xl bg-[var(--color-primary-light)]/20 text-[var(--color-primary-light)] mb-3 group-hover:bg-[var(--color-primary-light)]/30 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={iconMap[ind.icon] || iconMap["shield"]} />
          </div>

          <!-- Industry name -->
          <h3 class="text-sm font-bold text-white mb-1">{ind.name}</h3>

          <!-- Company -->
          <p class="text-xs text-white/60 mb-2">
            {countryFlag[ind.country]} {ind.company}
          </p>

          <!-- Period -->
          <p class="text-[10px] text-white/40 uppercase tracking-wider">{ind.period}</p>

          <!-- Impact on hover -->
          <div class="mt-3 pt-3 border-t border-white/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <p class="text-xs text-[var(--color-primary-light)]">{ind.impact}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
