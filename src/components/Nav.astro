---
import { siteConfig } from "../config";
---

<!-- Mobile: hamburger. Desktop: floating pill nav -->
<nav id="floating-nav" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 opacity-0 pointer-events-none transition-all duration-300">
  <div class="bg-[var(--color-primary-dark)]/95 backdrop-blur-md rounded-full px-6 py-3 shadow-lg border border-white/10">
    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-6">
      <a href="#perfil" class="text-white/70 hover:text-white text-sm font-medium transition-colors">Perfil</a>
      <a href="#industrias" class="text-white/70 hover:text-white text-sm font-medium transition-colors">Industrias</a>
      <a href="#impacto" class="text-white/70 hover:text-white text-sm font-medium transition-colors">Impacto</a>
      <a href="#trayectoria" class="text-white/70 hover:text-white text-sm font-medium transition-colors">Trayectoria</a>
      <a href="#certificaciones" class="text-white/70 hover:text-white text-sm font-medium transition-colors">Certificaciones</a>
      <a href="#contacto" class="text-[var(--color-primary-light)] hover:text-white text-sm font-semibold transition-colors">Contacto</a>
    </div>

    <!-- Mobile hamburger -->
    <div class="md:hidden flex items-center">
      <button id="mobile-menu-btn" class="text-white p-1" aria-label="Menú de navegación">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      <span class="text-white/80 text-sm ml-3 font-medium">GP</span>
    </div>
  </div>

  <!-- Mobile dropdown -->
  <div id="mobile-menu" class="md:hidden hidden mt-2 bg-[var(--color-primary-dark)]/95 backdrop-blur-md rounded-2xl px-6 py-4 shadow-lg border border-white/10">
    <div class="flex flex-col gap-3">
      <a href="#perfil" class="text-white/70 hover:text-white text-sm font-medium transition-colors mobile-nav-link">Perfil</a>
      <a href="#industrias" class="text-white/70 hover:text-white text-sm font-medium transition-colors mobile-nav-link">Industrias</a>
      <a href="#impacto" class="text-white/70 hover:text-white text-sm font-medium transition-colors mobile-nav-link">Impacto</a>
      <a href="#trayectoria" class="text-white/70 hover:text-white text-sm font-medium transition-colors mobile-nav-link">Trayectoria</a>
      <a href="#certificaciones" class="text-white/70 hover:text-white text-sm font-medium transition-colors mobile-nav-link">Certificaciones</a>
      <a href="#contacto" class="text-[var(--color-primary-light)] hover:text-white text-sm font-semibold transition-colors mobile-nav-link">Contacto</a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('floating-nav');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    if (!nav) return;

    if (currentScroll > 400) {
      nav.classList.remove('opacity-0', 'pointer-events-none');
      nav.classList.add('opacity-100', 'pointer-events-auto', 'header-visible');
    } else {
      nav.classList.add('opacity-0', 'pointer-events-none');
      nav.classList.remove('opacity-100', 'pointer-events-auto');
    }
    lastScroll = currentScroll;
  });

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });
</script>
