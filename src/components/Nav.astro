---
import { siteConfig } from "../config";
---

<nav id="floating-nav" class="fixed top-3 left-1/2 -translate-x-1/2 z-50 opacity-0 pointer-events-none transition-all duration-300">
  <div class="bg-[#0f2b4c]/90 backdrop-blur-md rounded-full shadow-lg border border-white/10 px-4 py-2 md:px-6 md:py-3">
    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-6">
      <a href="#perfil" class="text-white/70 hover:text-white text-sm font-medium transition-colors">Perfil</a>
      <a href="#industrias" class="text-white/70 hover:text-white text-sm font-medium transition-colors">Industrias</a>
      <a href="#impacto" class="text-white/70 hover:text-white text-sm font-medium transition-colors">Impacto</a>
      <a href="#trayectoria" class="text-white/70 hover:text-white text-sm font-medium transition-colors">Trayectoria</a>
      <a href="#certificaciones" class="text-white/70 hover:text-white text-sm font-medium transition-colors">Certificaciones</a>
      <a href="#contacto" class="text-[#4da8da] hover:text-white text-sm font-semibold transition-colors">Contacto</a>
    </div>

    <!-- Mobile: compact pill -->
    <div class="md:hidden flex items-center gap-2">
      <button id="mobile-menu-btn" class="text-white p-0.5" aria-label="Menú">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      <span class="text-white/70 text-xs font-medium">Menú</span>
    </div>
  </div>

  <!-- Mobile dropdown -->
  <div id="mobile-menu" class="md:hidden hidden mt-2 bg-[#0f2b4c]/95 backdrop-blur-md rounded-2xl px-5 py-3 shadow-lg border border-white/10">
    <div class="flex flex-col gap-2.5">
      <a href="#perfil" class="text-white/70 hover:text-white text-sm transition-colors mobile-nav-link">Perfil</a>
      <a href="#industrias" class="text-white/70 hover:text-white text-sm transition-colors mobile-nav-link">Industrias</a>
      <a href="#impacto" class="text-white/70 hover:text-white text-sm transition-colors mobile-nav-link">Impacto</a>
      <a href="#trayectoria" class="text-white/70 hover:text-white text-sm transition-colors mobile-nav-link">Trayectoria</a>
      <a href="#certificaciones" class="text-white/70 hover:text-white text-sm transition-colors mobile-nav-link">Certificaciones</a>
      <a href="#contacto" class="text-[#4da8da] hover:text-white text-sm font-semibold transition-colors mobile-nav-link">Contacto</a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('floating-nav');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    if (!nav) return;
    if (window.scrollY > 500) {
      nav.classList.remove('opacity-0', 'pointer-events-none');
      nav.classList.add('opacity-100', 'pointer-events-auto', 'header-visible');
    } else {
      nav.classList.add('opacity-0', 'pointer-events-none');
      nav.classList.remove('opacity-100', 'pointer-events-auto');
    }
  });

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => mobileMenu?.classList.add('hidden'));
  });
</script>
